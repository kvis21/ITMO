                    <mxGeometry x="-2120" y="-690" width="30" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="&lt;div&gt;n = len(x_list)&lt;/div&gt;&lt;div&gt;c = _nearest_index(x, x_list)&lt;/div&gt;" style="whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="-2320" y="-600" width="190" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="t = (x - x_list[c]) / h" style="whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="-2290" y="-520" width="130" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="|t| &lt;= 0.25" style="rhombus;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="-2310" y="-460" width="170" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="15" value="error" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" parent="1" vertex="1">
                    <mxGeometry x="-2100" y="-457.5" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="16" value="&lt;div&gt;table = build_finite_difference_table(y_list)&lt;/div&gt;&lt;div&gt;value = y_list[c]&lt;/div&gt;&lt;div&gt;max_m = min(c-1, n-c-2)&lt;/div&gt;" style="whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="-2350" y="-377.5" width="250" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="17" value="0 &lt;= c-1 &amp;&amp; c &lt; n-1" style="rhombus;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="-2307.5" y="-297.5" width="165" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="18" value="value = value + t * (table[1][c-1] + table[1][c]) / 2" style="whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="-2540" y="-297.5" width="210" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="24" value="0 &lt;= c-1 &amp;&amp; c-1 &lt; n-2" style="rhombus;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="-2307.5" y="-208.75" width="165" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="23" value="value = value + t * t / 2 * table[2][c-1]" style="whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="-2540" y="-208.75" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="255" value="" style="edgeStyle=none;html=1;" edge="1" parent="1" source="21" target="250">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="21" value="m = 1, max_m" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;" parent="1" vertex="1">
                    <mxGeometry x="-2295" y="-120" width="140" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="22" value="&lt;div&gt;k_odd = 2 * m + 1&lt;/div&gt;&lt;div&gt;k_even = 2 * m + 2&lt;/div&gt;&lt;div&gt;prod = 1&lt;/div&gt;" style="whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="-2325" y="-40" width="200" height="55" as="geometry"/>
                </mxCell>
