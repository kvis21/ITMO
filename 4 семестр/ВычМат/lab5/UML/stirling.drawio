                </mxCell>
                <mxCell id="27" value="&lt;div&gt;factor = t * prod / math.factorial(k_odd)&lt;/div&gt;&lt;div&gt;value = value + factor * (table[k_odd][c-m-1] + table[k_odd][c-m]) / 2&lt;/div&gt;&lt;div&gt;value = value + table[k_even][c-m-1] * t*t * prod / math.factorial(k_even)&lt;/div&gt;" style="whiteSpace=wrap;html=1;" parent="1" vertex="1">
